# Copy this file to .env (or export these as real environment variables)
# before running the application.

# ---- Server ----
SERVER_PORT=8080

# ---- Database ----
# For PostgreSQL (default):
DB_URL=jdbc:postgresql://localhost:5432/resource_booking
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# For MySQL, use these instead:
# DB_URL=jdbc:mysql://localhost:3306/resource_booking?useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

DDL_AUTO=update
SHOW_SQL=false

# ---- JWT ----
# Use a long, random, secret string in real deployments (32+ chars).
JWT_SECRET=this-is-a-very-long-development-only-secret-key-please-change-in-prod-0123456789
JWT_EXPIRATION_MS=86400000

# ---- Seed users (created automatically on first run) ----
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=User@123

LOG_LEVEL=INFO
